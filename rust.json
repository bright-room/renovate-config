{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Rust preset",
  "packageRules": [
    {
      "description": "Group all non-major Rust crate updates into a single PR",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "cargo dependencies"
    },
    {
      "description": "Group Tauri updates (crates and npm packages)",
      "matchPackageNames": ["@tauri-apps/**", "tauri", "tauri-build", "tauri-plugin-*"],
      "groupName": "Tauri"
    }
  ]
}
